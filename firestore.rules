rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Herkes yalnızca kendi kadrosunu okuyup yazabilir.
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      // Yazılan belge sadece { state: metin (<1 MB), ts: sayı } olabilir.
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['state', 'ts'])
        && request.resource.data.state is string
        && request.resource.data.state.size() < 1000000
        && request.resource.data.ts is number;
    }
  }
}
